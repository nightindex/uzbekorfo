<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="Ribbon_Load">
  <contextMenus>
    <contextMenu idMso="ContextMenuText">
      <dynamicMenu id="UzbekOrfo_SpellingMenu"
                    getContent="GetSpellingMenuContent"
                    getVisible="GetSpellingMenuVisible"
                    label="Имло"
                    imageMso="SpellingAndGrammar"
                    insertBeforeMso="Cut" />

      <button id="UzbekOrfo_AddToDict"
              getLabel="GetAddToDictLabel"
              getVisible="GetAddToDictVisible"
              imageMso="AddToDictionary"
              onAction="OnAddToDict"
              insertBeforeMso="Cut" />

      <menuSeparator id="UzbekOrfo_SepSuggestions"
                     insertBeforeMso="Cut" />

      <button id="UzbekOrfo_Suggestions"
              label="Вариантлар"
              imageMso="AutoCorrect"
              onAction="OnSuggestionsClick"
              getVisible="GetSuggestionsVisible"
              insertBeforeMso="Cut" />
    </contextMenu>
  </contextMenus>
</customUI>
